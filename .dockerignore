# the whole build context is sent to the Docker daemon. Without this file
# .venv, .git and logs go with it — hundreds of megabytes and minutes wasted.
.venv/
venv/
.git/
.gitignore
.idea/
__pycache__/
*.py[cod]

# secrets NEVER go into an image — anyone holding it can unpack and read it.
.env
*.pem

logs/
*.log
media/
staticfiles/
db.sqlite3
django_ru.po
django_de.po
*.md