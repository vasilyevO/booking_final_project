SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost

# DB_ENGINE=sqlite   # use a local SQLite file instead of MySQL
DB_NAME=booking_db
DB_USER=booking_user
DB_PASSWORD=your-password-here
DB_HOST=127.0.0.1
DB_PORT=3306
DB_ROOT_PASSWORD=your-root-password-here

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@booking.local
SITE_URL=http://localhost

BOOKING_CANCELLATION_DAYS=1
REVIEW_EDIT_WINDOW_DAYS=14

LOG_LEVEL=INFO
LOG_TO_FILE=True
LOG_SQL=False
QUERY_COUNT_WARNING=20
IN_CONTAINER=False

# On the server these differ: DEBUG=False, a new SECRET_KEY, ALLOWED_HOSTS,
# CSRF_TRUSTED_ORIGINS and SITE_URL with the public IP, new database
# passwords, LOG_TO_FILE=False. Never use "$" in values — Compose
# substitutes it. See README, "Deployment to AWS EC2".
