# --- темы писем ---
msgid "Your booking request has been created"
msgstr "Ihre Buchungsanfrage wurde erstellt"

msgid "New booking request for your property"
msgstr "Neue Buchungsanfrage für Ihre Unterkunft"

msgid "Your booking has been confirmed"
msgstr "Ihre Buchung wurde bestätigt"

msgid "Your booking has been rejected"
msgstr "Ihre Buchung wurde abgelehnt"

msgid "Your booking has been cancelled"
msgstr "Ihre Buchung wurde storniert"

msgid "Your stay is complete — leave a review"
msgstr "Ihr Aufenthalt ist beendet — hinterlassen Sie eine Bewertung"

# --- тела писем (blocktranslate) ---
#, python-format
msgid "Your booking request for \"%(title)s\" has been created."
msgstr "Ihre Buchungsanfrage für „%(title)s“ wurde erstellt."

#, python-format
msgid "New booking request for \"%(title)s\"."
msgstr "Neue Buchungsanfrage für „%(title)s“."

#, python-format
msgid "Your booking for \"%(title)s\" is now: %(status)s."
msgstr "Ihre Buchung für „%(title)s“ hat jetzt den Status: %(status)s."

msgid "The owner will confirm or reject your request."
msgstr "Der Eigentümer wird Ihre Anfrage bestätigen oder ablehnen."

msgid "City, any spelling"
msgstr "Stadt, beliebige Schreibweise"

msgid "Minimum price, EUR"
msgstr "Mindestpreis, EUR"

msgid "Maximum price, EUR"
msgstr "Höchstpreis, EUR"

msgid "Search and filter listings"
msgstr "Inserate suchen und filtern"

msgid "Listing details"
msgstr "Inseratsdetails"

msgid "Create a listing"
msgstr "Inserat erstellen"

msgid "Update a listing"
msgstr "Inserat aktualisieren"

msgid "Replace a listing"
msgstr "Inserat vollständig ersetzen"

msgid "Soft-delete a listing"
msgstr "Inserat als gelöscht markieren"

msgid "Upload a photo"
msgstr "Foto hochladen"

msgid "Reorder photos"
msgstr "Fotos neu anordnen"

msgid "Reviews of this listing"
msgstr "Bewertungen dieses Inserats"

msgid "My bookings, as a tenant or as a landlord"
msgstr "Meine Buchungen – als Mieter oder als Vermieter"

msgid "Create a booking"
msgstr "Buchung erstellen"

msgid "Change dates or guest count of a pending booking"
msgstr "Zeitraum oder Gästezahl einer offenen Buchung ändern"

msgid "Confirm a booking (landlord only)"
msgstr "Buchung bestätigen (nur Vermieter)"

msgid "Reject a booking (landlord only)"
msgstr "Buchung ablehnen (nur Vermieter)"

msgid "Cancel a booking (tenant or landlord)"
msgstr "Buchung stornieren (Mieter oder Vermieter)"

msgid "Register a new account"
msgstr "Neues Konto registrieren"

msgid "Current user profile"
msgstr "Profil des aktuellen Benutzers"

msgid "Most searched keywords"
msgstr "Meistgesuchte Suchbegriffe"

msgid "Most viewed listings"
msgstr "Meistaufgerufene Inserate"

msgid ""
"Short headline shown in search results, e.g. 'Bright 2-room flat near Rhine'"
msgstr ""
"Kurze Überschrift für die Suchergebnisse, z. B. „Helle 2-Zimmer-Wohnung am "
"Rhein“"

msgid "Full description: layout, furniture, neighbourhood, house rules"
msgstr ""
"Vollständige Beschreibung: Grundriss, Möblierung, Umgebung, Hausordnung"

msgid "City as displayed, e.g. Köln"
msgstr "Stadt wie angezeigt, z. B. Köln"

msgid ""
"Folded lowercase form used for search: Köln, Koeln and koln all become koeln"
msgstr ""
"Vereinheitlichte Kleinschreibung für die Suche: Köln, Koeln und koln werden "
"zu koeln"

msgid "District or quarter, optional"
msgstr "Stadtteil oder Viertel, optional"

msgid "Street and house number, e.g. Hohe Straße 12. Optional"
msgstr "Straße und Hausnummer, z. B. Hohe Straße 12. Optional"

msgid "Postal code, e.g. 50667. Optional"
msgstr "Postleitzahl, z. B. 50667. Optional"

msgid "Price per one night in the chosen currency, e.g. 89.50"
msgstr "Preis für eine Nacht in der gewählten Währung, z. B. 89.50"

msgid "Computed automatically, used for filtering and sorting"
msgstr "Wird automatisch berechnet und zum Filtern und Sortieren verwendet"

msgid "Number of rooms, from 1 to 50"
msgstr "Anzahl der Zimmer, von 1 bis 50"

msgid "apartment, house, studio or room"
msgstr "Wohnung, Haus, Studio oder Zimmer"

msgid "Inactive listings are hidden from search but keep their bookings"
msgstr ""
"Inaktive Inserate sind in der Suche ausgeblendet, ihre Buchungen bleiben "
"erhalten"

msgid "JPEG or PNG, at least 800x600 px"
msgstr "JPEG oder PNG, mindestens 800x600 px"

msgid "Optional caption, e.g. 'Living room'"
msgstr "Optionale Bildunterschrift, z. B. „Wohnzimmer“"

msgid "Display order, ascending. The lowest value is the cover photo"
msgstr "Anzeigereihenfolge, aufsteigend. Der niedrigste Wert ist das Titelbild"

msgid "Check-in date, inclusive. Format YYYY-MM-DD"
msgstr "Anreisedatum, einschließlich. Format JJJJ-MM-TT"

msgid "Check-out date, exclusive: this night is not charged"
msgstr "Abreisedatum, ausschließlich: diese Nacht wird nicht berechnet"

msgid "Number of guests, from 1 to 20"
msgstr "Anzahl der Gäste, von 1 bis 20"

msgid "Number of guests, at least 1"
msgstr "Anzahl der Gäste, mindestens 1"

msgid "Lifecycle status. Changed only through the booking actions"
msgstr "Lebenszyklus-Status. Wird nur über die Buchungsaktionen geändert"

msgid "Discount applied at booking time, 0 to 100 percent"
msgstr "Rabatt zum Zeitpunkt der Buchung, 0 bis 100 Prozent"

msgid "Agreed contract amount, frozen at booking time"
msgstr "Vereinbarter Vertragsbetrag, zum Zeitpunkt der Buchung festgeschrieben"

msgid "public_id of the listing to book"
msgstr "public_id des zu buchenden Inserats"

msgid "Target status. Allowed transitions are defined by the state machine"
msgstr ""
"Zielstatus. Zulässige Übergänge werden durch den Zustandsautomaten festgelegt"

msgid "Rating from 1 to 5"
msgstr "Bewertung von 1 bis 5"

msgid "Free-form review, up to 2000 characters"
msgstr "Freitext-Bewertung, bis zu 2000 Zeichen"

msgid "public_id of the completed booking being reviewed"
msgstr "public_id der abgeschlossenen Buchung, die bewertet wird"

msgid "All photo ids of this listing, in the desired display order"
msgstr "Alle Foto-IDs dieses Inserats in der gewünschten Anzeigereihenfolge"

msgid "Language used for emails and notifications"
msgstr "Sprache für E-Mails und Benachrichtigungen"

msgid "Role groups the user belongs to"
msgstr "Rollengruppen, denen der Benutzer angehört"

msgid "At least 8 characters, not entirely numeric"
msgstr "Mindestens 8 Zeichen, nicht nur Ziffern"

msgid "Repeat the password exactly"
msgstr "Passwort exakt wiederholen"

msgid "tenants may book and review, landlords may publish listings"
msgstr ""
"tenants dürfen buchen und bewerten, landlords dürfen Inserate veröffentlichen"

msgid "De-duplicated views, one per user per day"
msgstr "Aufrufe ohne Duplikate: einer pro Nutzer pro Tag"

msgid "Normalised search keyword"
msgstr "Normalisierter Suchbegriff"

msgid "How many times it was searched"
msgstr "Wie oft danach gesucht wurde"

msgid "Total de-duplicated views"
msgstr "Aufrufe ohne Duplikate insgesamt"

msgid "Free-text search in title and description"
msgstr "Freitextsuche in Titel und Beschreibung"

msgid "City in any spelling: Köln, Koeln, koln"
msgstr "Stadt in beliebiger Schreibweise: Köln, Koeln, koln"

msgid "Minimum price per night, EUR"
msgstr "Mindestpreis pro Nacht, EUR"

msgid "Maximum price per night, EUR"
msgstr "Höchstpreis pro Nacht, EUR"

#, python-format
msgid "Sort order. Available fields: %(fields)s"
msgstr "Sortierreihenfolge. Verfügbare Felder: %(fields)s"
