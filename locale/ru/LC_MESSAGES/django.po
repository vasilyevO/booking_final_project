msgid "The discount cannot exceed 100 percent."
msgstr "Скидка не может превышать 100 процентов."

# --- сообщения об ошибках ---
#: .\apps\bookings\models.py:321
msgid "A booking cannot start in the past."
msgstr "Нельзя бронировать в прошлом."

