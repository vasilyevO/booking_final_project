# bookings
# ============================================================
#: .\apps\bookings\models.py:187
msgid "Booking"
msgstr "Бронирование"

#: .\apps\bookings\models.py:188
msgid "Bookings"
msgstr "Бронирования"

#: .\apps\bookings\models.py:204
msgid "The check-out date must be later than the check-in date."
msgstr "Дата выезда должна быть позже даты заезда."

