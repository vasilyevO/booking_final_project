msgid "These dates are already booked."
msgstr "Эти даты уже заняты."

#: .\apps\bookings\models.py:345
#, python-format
msgid "Transition %(old)s to %(new)s is not allowed."
msgstr "Переход %(old)s в %(new)s недопустим."

